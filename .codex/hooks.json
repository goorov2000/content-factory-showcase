{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/guard_protected_paths.py\"",
            "timeout": 30,
            "statusMessage": "guard: защищённые пути (prompts/**, .claude/commands/**, formulas/_approved/**)"
          }
        ]
      }
    ]
  }
}
