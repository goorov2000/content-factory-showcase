{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CF content formula",
  "type": "object",
  "required": ["name", "niche", "hook_structure", "problem_definition",
               "solution_structure", "visual_requirements", "cta_type", "prohibitions",
               "evidence", "confidence", "conditions", "source_pattern_ids",
               "version", "updated_at"],
  "properties": {
    "name": {"type": "string", "minLength": 3},
    "niche": {"type": "string", "minLength": 1},
    "hook_structure": {
      "type": "object",
      "required": ["timing", "elements"],
      "properties": {
        "timing": {"type": "string", "minLength": 1},
        "elements": {"type": "array", "minItems": 1,
                     "items": {"type": "string", "minLength": 1}}
      }
    },
    "problem_definition": {"type": "string", "minLength": 10},
    "solution_structure": {"type": "object"},
    "visual_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "cta_type": {"type": "string", "minLength": 1},
    "prohibitions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "object",
      "required": ["source_urls", "avg_views", "avg_er"],
      "properties": {
        "source_urls": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https?://"}
        },
        "avg_views": {"type": "number"},
        "avg_er": {"type": "number"},
        "visual_refs": {
          "description": "Визуальные основания «обложка видео X» / «кадр N видео X» (машинная форма, тикет 08 визуального контура). ОПЦИОНАЛЬНО: чисто текстовый evidence легален. Резолвится машинными воротами (visual_refs_resolve).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_url", "media"],
            "properties": {
              "source_url": {"type": "string", "pattern": "^https?://"},
              "media": {"enum": ["cover", "frame"]},
              "frame_index": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false,
            "if": {"properties": {"media": {"const": "frame"}}},
            "then": {"required": ["source_url", "media", "frame_index"]}
          }
        }
      }
    },
    "confidence": {"enum": ["high", "medium"]},
    "conditions": {"type": "string", "minLength": 5},
    "source_pattern_ids": {"type": "array", "minItems": 1,
                           "items": {"type": "string", "minLength": 1}},
    "version": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string"},
    "status": {"enum": ["proposed", "approved", "paused", "rejected"]},
    "status_reason": {"type": "string"}
  }
}
