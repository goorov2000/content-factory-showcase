[Unit]
Description=CF: еженедельный тюнинг источников (агент)
After=network-online.target
OnFailure=cf-alert@%n.service

[Service]
Type=oneshot
User=<user>
WorkingDirectory=/home/<user>/projects/CF
Environment=PATH=/home/<user>/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/<user>/.local/bin/claude -p /cf-tune-sources
