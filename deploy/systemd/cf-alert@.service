[Unit]
# Уведомитель о падении службы. Подключается к остальным юнитам строкой
# OnFailure=cf-alert@%n.service — systemd сам подставляет имя упавшего юнита.
#
# Отдельный процесс — это и есть смысл (разбор 2026-08-09): единственный
# отправитель уведомлений жил внутри cf-dashboard, поэтому его собственную
# смерть заметить было некому. До этой правки OnFailure= не было ни у одного
# юнита, и падения бэкапа, архивации и утреннего запуска не доходили ни до кого.
# Имя упавшего юнита подставляется как %i, а НЕ %I: %I — это ИМЯ ПОСЛЕ
# РАСЭКРАНИРОВАНИЯ, и systemd превращает в нём дефис в слэш. До правки
# 14.09.2026 владелец получал в чате «упало cf/backup.service» —
# юнита с таким именем не существует, и найти его по этой строке нельзя.
Description=CF: сказать владельцу, что упало %i

[Service]
Type=oneshot
User=<user>
WorkingDirectory=/home/<user>/projects/CF
Environment=PATH=/home/<user>/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/<user>/projects/CF/.venv/bin/python -m cf alert-unit %i
